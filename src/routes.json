{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "webservices.rest": ">=2.40.0",
    "actcore": ">=1.0.0-0",
    "cohort": ">=3.7.3"
  },
  "extensions": [
    {
      "name": "act-home-dashboard-link",
      "slot": "homepage-dashboard-slot",
      "component": "actHomeDashboardLink",
      "meta": {
        "name": "act-home",
        "slot": "rhd-home-dashboard-slot",
        "title": "actHome"
      },
      "privileges": "App: act.home"
    },
    {
      "name": "act-home-dashboard",
      "slot": "rhd-home-dashboard-slot",
      "component": "actHomeDashboard",
      "privileges": "App: act.home"
    },
    {
      "name": "act-home-quick-actions",
      "slot": "rhd-home-widgets-slot",
      "component": "actHomeQuickActions",
      "order": 1,
      "privileges": "App: act.home"
    },
    {
      "name": "act-home-worklists",
      "slot": "rhd-home-widgets-slot",
      "component": "actHomeWorklists",
      "order": 2,
      "privileges": "App: act.worklists"
    },
    {
      "name": "act-home-waiting-list",
      "slot": "rhd-home-widgets-slot",
      "component": "actHomeWaitingList",
      "order": 3,
      "privileges": "App: act.waitingList"
    },
    {
      "name": "act-home-care-cascade",
      "slot": "rhd-home-widgets-slot",
      "component": "actHomeCareCascade",
      "order": 4,
      "privileges": "App: act.registry"
    },
    {
      "name": "act-registry-dashboard-link",
      "slot": "homepage-dashboard-slot",
      "component": "registryDashboardLink",
      "meta": {
        "name": "act-registry",
        "slot": "rhd-registry-dashboard-slot",
        "title": "registry"
      },
      "privileges": "App: act.registry"
    },
    {
      "name": "act-registry-dashboard",
      "slot": "rhd-registry-dashboard-slot",
      "component": "registryDashboard",
      "privileges": "App: act.registry"
    },
    {
      "name": "act-worklists-dashboard-link",
      "slot": "homepage-dashboard-slot",
      "component": "worklistsDashboardLink",
      "meta": {
        "name": "act-worklists",
        "slot": "rhd-worklists-dashboard-slot",
        "title": "worklists"
      },
      "privileges": "App: act.worklists"
    },
    {
      "name": "act-worklists-dashboard",
      "slot": "rhd-worklists-dashboard-slot",
      "component": "worklistsDashboard",
      "privileges": "App: act.worklists"
    },
    {
      "name": "act-waiting-list-dashboard-link",
      "slot": "homepage-dashboard-slot",
      "component": "waitingListDashboardLink",
      "meta": {
        "name": "act-waiting-list",
        "slot": "rhd-waiting-list-dashboard-slot",
        "title": "waitingList"
      },
      "privileges": "App: act.waitingList"
    },
    {
      "name": "act-waiting-list-dashboard",
      "slot": "rhd-waiting-list-dashboard-slot",
      "component": "waitingListDashboard",
      "privileges": "App: act.waitingList"
    },
    {
      "name": "act-screen-positive-dashboard-link",
      "slot": "homepage-dashboard-slot",
      "component": "screenPositiveDashboardLink",
      "meta": {
        "name": "act-screen-positive",
        "slot": "rhd-screen-positive-dashboard-slot",
        "title": "screenPositive"
      },
      "privileges": "App: act.screenPositive"
    },
    {
      "name": "act-screen-positive-dashboard",
      "slot": "rhd-screen-positive-dashboard-slot",
      "component": "screenPositiveDashboard",
      "privileges": "App: act.screenPositive"
    },
    {
      "name": "act-back-to-act-link",
      "slot": "top-of-all-patient-dashboards-slot",
      "component": "backToActLink",
      "privileges": "App: act.home"
    },
    {
      "name": "act-prophylaxis-status-tag",
      "slot": "patient-banner-tags-slot",
      "component": "prophylaxisStatusTag",
      "privileges": [
        "Get Encounters",
        "Get Observations"
      ]
    },
    {
      "name": "act-prophylaxis-dashboard-link",
      "component": "prophylaxisPageDashboardLink",
      "meta": {
        "slot": "act-prophylaxis-dashboard-slot",
        "path": "act-prophylaxis",
        "title": "Prophylaxis",
        "icon": "omrs-icon-medication"
      },
      "privileges": [
        "Get Encounters",
        "Get Observations"
      ]
    },
    {
      "name": "act-prophylaxis-dashboard",
      "slot": "act-prophylaxis-dashboard-slot",
      "component": "prophylaxisPageDashboard",
      "meta": {
        "fullWidth": true
      },
      "privileges": [
        "Get Encounters",
        "Get Observations"
      ]
    },
    {
      "name": "act-cardiac-tests-dashboard-link",
      "component": "cardiacTestsDashboardLink",
      "meta": {
        "slot": "act-cardiac-tests-dashboard-slot",
        "path": "act-cardiac-tests",
        "title": "Cardiac tests",
        "icon": "omrs-icon-activity"
      },
      "privileges": [
        "Get Encounters",
        "Get Observations"
      ]
    },
    {
      "name": "act-cardiac-tests-dashboard",
      "slot": "act-cardiac-tests-dashboard-slot",
      "component": "cardiacTestsDashboard",
      "meta": {
        "fullWidth": true
      },
      "privileges": [
        "Get Encounters",
        "Get Observations"
      ]
    },
    {
      "name": "act-prophylaxis-card",
      "slot": "patient-chart-summary-dashboard-slot",
      "component": "prophylaxisCard",
      "order": 0,
      "meta": {
        "fullWidth": true
      },
      "privileges": [
        "Get Encounters",
        "Get Observations"
      ]
    }
  ],
  "workspaceGroups2": [
    {
      "name": "act-waiting-list",
      "scopePattern": "/home/act-waiting-list"
    },
    {
      "name": "act-screen-positive",
      "scopePattern": "/home/act-screen-positive"
    }
  ],
  "workspaceWindows2": [
    {
      "name": "act-waiting-list-form-entry",
      "group": "act-waiting-list",
      "width": "extra-wide",
      "canMaximize": true
    },
    {
      "name": "act-screen-positive-form-entry",
      "group": "act-screen-positive",
      "width": "extra-wide",
      "canMaximize": true
    }
  ],
  "workspaces2": [
    {
      "name": "rhd-flag-gaps-workspace",
      "component": "flagGapsWorkspace",
      "window": "patient-chart-clinical-forms"
    },
    {
      "name": "act-waiting-list-form-entry-workspace",
      "component": "@openmrs/esm-patient-forms-app#exportedPatientFormEntryWorkspace",
      "window": "act-waiting-list-form-entry"
    },
    {
      "name": "act-screen-positive-form-entry-workspace",
      "component": "@openmrs/esm-patient-forms-app#exportedPatientFormEntryWorkspace",
      "window": "act-screen-positive-form-entry"
    }
  ]
}
